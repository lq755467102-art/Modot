{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Modot worker contribution, 1-draft",
  "description": "Schema for plugin.json.workers. Runtime also enforces bounded finite JSON, keyword/type compatibility, known required capabilities and depth <= 8.",
  "type": "array",
  "maxItems": 8,
  "items": {"$ref": "#/$defs/worker"},
  "$defs": {
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "protocol", "description", "method", "inputSchema", "outputSchema", "requires"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,47}$"},
        "protocol": {"const": "modot.worker/1-draft"},
        "description": {"type": "string", "minLength": 1, "maxLength": 240},
        "method": {"type": "string", "minLength": 1, "maxLength": 2000},
        "modelRole": {"enum": ["vision"]},
        "inputSchema": {"allOf": [{"$ref": "#/$defs/dataSchema"}, {"properties": {"type": {"const": "object"}}}]},
        "outputSchema": {"$ref": "#/$defs/dataSchema"},
        "requires": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"enum": ["native-l0", "independent-history", "messages", "resume", "cancel", "structured-result", "read-code", "isolated-write", "isolated-check", "cross-parent-run", "automatic-wakeup"]}},
        "optional": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "dataSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["object", "array", "string", "integer", "number", "boolean", "null"]},
        "description": {"type": "string"},
        "properties": {"type": "object", "maxProperties": 64, "additionalProperties": {"$ref": "#/$defs/dataSchema"}},
        "required": {"type": "array", "items": {"type": "string"}},
        "additionalProperties": {"type": "boolean"},
        "items": {"$ref": "#/$defs/dataSchema"},
        "enum": {"type": "array", "minItems": 1},
        "minLength": {"type": "integer", "minimum": 0},
        "maxLength": {"type": "integer", "minimum": 0},
        "minItems": {"type": "integer", "minimum": 0},
        "maxItems": {"type": "integer", "minimum": 0},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"}
      },
      "allOf": [{"if": {"properties": {"type": {"const": "array"}}}, "then": {"required": ["items"]}}]
    },
    "delegate": {
      "type": "object", "additionalProperties": false,
      "required": ["worker", "request_key", "input", "resource_ids", "kind"],
      "properties": {
        "worker": {"type": "string"}, "request_key": {"type": "string", "minLength": 1, "maxLength": 100},
        "input": {"type": "object"}, "resource_ids": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string"}},
        "kind": {"enum": ["report", "code"]}, "expected_revision": {"type": "string"},
        "model_calls": {"type": "integer", "minimum": 0, "maximum": 1000000}
      }
    },
    "manage": {
      "type": "object", "additionalProperties": false,
      "required": ["action", "delegation_id"],
      "properties": {
        "action": {"enum": ["query", "message", "resume", "cancel", "result", "receipt"]},
        "delegation_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "request_key": {"type": "string", "minLength": 1, "maxLength": 100},
        "text": {"type": "string", "minLength": 1, "maxLength": 8000},
        "result_id": {"type": "string", "pattern": "^wres-[0-9a-f]{32}$"},
        "disposition": {"enum": ["accepted", "partial", "rejected", "deferred"]}
      },
      "allOf": [
        {"if": {"properties": {"action": {"enum": ["query", "cancel"]}}}, "then": {"maxProperties": 2}},
        {"if": {"properties": {"action": {"enum": ["message", "resume"]}}}, "then": {"required": ["request_key", "text"], "maxProperties": 4}},
        {"if": {"properties": {"action": {"const": "result"}}}, "then": {"required": ["result_id"], "maxProperties": 3}},
        {"if": {"properties": {"action": {"const": "receipt"}}}, "then": {"required": ["request_key", "result_id", "disposition"], "maxProperties": 5}}
      ]
    },
    "submit": {
      "type": "object", "additionalProperties": false, "required": ["submission_key", "data"],
      "properties": {"submission_key": {"type": "string", "minLength": 1, "maxLength": 100}, "data": {}}
    }
  }
}
