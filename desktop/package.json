{
  "name": "modot-public-preview",
  "version": "0.2.0-preview.16",
  "private": true,
  "description": "A customizable desktop AI agent with project workrooms, replaceable memory, and specialist task cores.",
  "main": "main.js",
  "scripts": {
    "setup:v2": "npm --prefix renderer-v2 ci",
    "build:v2": "npm --prefix renderer-v2 run build",
    "start": "npm run build:v2 && node launch.cjs",
