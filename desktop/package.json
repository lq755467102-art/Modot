    "pack": "node scripts/build-release.cjs --dir",
    "dist": "node scripts/build-release.cjs --nsis --signed",
    "dist:local": "node scripts/build-release.cjs --nsis"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12",
    "@types/node": "24.19.2",
    "undici-types": "7.24.6"
  },
