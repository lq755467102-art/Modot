{
  "name": "modot-theia-testing-host",
  "private": true,
  "version": "1.0.0",
  "engines": { "node": ">=24" },
  "scripts": { "build": "theia build --mode production", "postbuild": "node -e \"require('node:fs').writeFileSync('lib/formatting-v1.ready', '1')\"" },
  "theia": { "target": "browser", "frontend": { "config": { "applicationName": "Modot Testing Host" } } },
  "dependencies": {
    "modot-testing-bridge": "file:./bridge",
    "@theia/core": "1.77.0",
    "@theia/editor": "1.77.0",
    "@theia/navigator": "1.77.0",
    "@theia/monaco": "1.77.0",
    "@theia/preferences": "1.77.0",
    "@theia/plugin-ext-vscode": "1.77.0",
    "@theia/terminal": "1.77.0",
    "@theia/test": "1.77.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": { "@theia/cli": "1.77.0" }
}
